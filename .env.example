# WordPress WPGraphQL Endpoint
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=https://digitalwebstudio.in/graphql

# Next.js On-Demand Revalidation Secret
WORDPRESS_REVALIDATION_SECRET=dws_revalidation_secret_2026

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://digitalwebstudio.in

# SMTP Email Configuration (Brevo / Hostinger / Custom)
# For Brevo (Sendinblue):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_login_email@domain.com
# SMTP_PASS=your_brevo_smtp_key_here
# SMTP_FROM=contact@digitalwebstudio.in
# CONTACT_TO_EMAIL=contact@digitalwebstudio.in, jeevawebstudio@gmail.com

# For Hostinger:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@digitalwebstudio.in
SMTP_PASS=your_smtp_password_here
SMTP_FROM=contact@digitalwebstudio.in
CONTACT_TO_EMAIL=contact@digitalwebstudio.in, jeevawebstudio@gmail.com
