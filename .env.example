# WordPress WPGraphQL Endpoint
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=https://cms.digitalwebstudio.in/graphql

# Next.js On-Demand Revalidation Secret
WORDPRESS_REVALIDATION_SECRET=dws_revalidation_secret_2026

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://digitalwebstudio.in

# Google Tag Manager & Analytics (Optional)
# Replace with your GTM Container ID (e.g., GTM-XXXXXXX) or GA4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# SMTP Email Configuration (Brevo / Hostinger / Custom)
# For Brevo (Sendinblue):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_login_email@domain.com
# SMTP_PASS=your_brevo_smtp_key_here
# SMTP_FROM=jnanadham178@gmail.com # (Must match your registered/verified Brevo sender)
# CONTACT_TO_EMAIL=contact@digitalwebstudio.in, jeevawebstudio@gmail.com

# For Hostinger:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@digitalwebstudio.in
SMTP_PASS=your_smtp_password_here
SMTP_FROM=contact@digitalwebstudio.in
CONTACT_TO_EMAIL=contact@digitalwebstudio.in, jeevawebstudio@gmail.com
